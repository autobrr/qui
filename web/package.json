{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:demo": "vite build --mode demo",
    "build": "tsc -b && vite build && node -e \"const fs=require('fs'); fs.mkdirSync('dist',{recursive:true}); fs.closeSync(fs.openSync('dist/.gitkeep','a'));\"",
    "preview": "vite preview",
    "check:i18n": "node --test \"scripts/*.test.mjs\" && node scripts/check-i18n-keys.mjs && node scripts/find-unused-i18n-keys.mjs && node scripts/check-legacy-plural-keys.mjs && vitest run src/i18n/index.test.ts src/i18n/plurals.test.ts src/hooks/useDateTimeFormatters.test.ts && node scripts/find-hardcoded-i18n-literals.mjs && node scripts/find-raw-backend-values.mjs && node scripts/check-locale-coverage.mjs",
    "check:i18n:plural-keys": "node scripts/check-legacy-plural-keys.mjs",
    "check:i18n:hardcoded": "node scripts/find-hardcoded-i18n-literals.mjs",
    "check:i18n:raw-backend-values": "node scripts/find-raw-backend-values.mjs",
    "check:i18n:unused": "node scripts/find-unused-i18n-keys.mjs",
    "check:i18n:zh-cn": "node scripts/check-locale-coverage.mjs zh-CN",
    "check:i18n:zh-tw": "node scripts/check-locale-coverage.mjs zh-TW",
    "check:i18n:fr": "node scripts/check-locale-coverage.mjs fr",
    "check:i18n:de": "node scripts/check-locale-coverage.mjs de",
    "check:i18n:cs": "node scripts/check-locale-coverage.mjs cs",
    "check:i18n:it": "node scripts/check-locale-coverage.mjs it",
    "check:i18n:uk": "node scripts/check-locale-coverage.mjs uk",
    "check:i18n:ko": "node scripts/check-locale-coverage.mjs ko",
    "check:i18n:pt-br": "node scripts/check-locale-coverage.mjs pt-BR",
    "check:i18n:ca": "node scripts/check-locale-coverage.mjs ca",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" \"*.{js,ts}\" \"scripts/**/*.mjs\"",
    "format": "eslint --fix \"src/**/*.{ts,tsx,js,jsx}\" \"*.{js,ts}\" \"scripts/**/*.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.21",
    "@uiw/react-codemirror": "^4.25.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "culori": "^4.0.2",
    "flag-icons": "^7.5.0",
    "i18next": "^26.4.7",
    "lucide-react": "^1.57.0",
    "motion": "^14.0.0",
    "parse-torrent": "^11.0.24",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.21",
    "react-resizable-panels": "^4.14.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.45",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.5",
    "@types/parse-torrent": "^11.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "30.1.3",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
